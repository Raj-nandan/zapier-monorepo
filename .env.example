# Phase 02 — Database
DATABASE_URL=postgres://zapier:zapier@localhost:5433/zapier
DIRECT_URL=postgres://zapier:zapier@localhost:5433/zapier

# Phase 03 — Auth / Backend
JWT_PASSWORD=                    # 32-byte random, external secret in prod
BACKEND_URL=http://localhost:3001
HOOKS_URL=http://localhost:3002
WEB_URL=http://localhost:3000
OAUTH_REDIRECT_URL=http://localhost:3001
TOKEN_ENC_KEY=                    # encrypts ConnectedAccount tokens

# Google/GitHub login OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Gmail/GitHub app connection OAuth (Phase 03)
GMAIL_APP_ID=
GMAIL_APP_SECRET=
GITHUB_APP_ID=
GITHUB_APP_SECRET=

# Redis (rate-limit, OAuth state, jti denylist)
REDIS_URL=redis://localhost:6379

# Kafka (Redpanda local, Upstash prod)
KAFKA_BROKERS=localhost:9092
TOPIC=zap-events

# Action integrations (Phase 03)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SLACK_BOT_TOKEN=
DISCORD_BOT_TOKEN=
