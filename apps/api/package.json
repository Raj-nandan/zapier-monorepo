{
  "name": "@repo/api",
  "private": true,
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "build": "tsc",
    "start": "bun run dist/index.js",
    "lint": "eslint .",
    "test": "bun test --pass-with-no-tests",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "bun run ../db/prisma/seed.ts"
  },
  "dependencies": {
    "@repo/config": "workspace:*",
    "@repo/db": "workspace:*",
    "@repo/schemas": "workspace:*",
    "@repo/logger": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.5.0",
    "prisma": "^5.0.0",
    "eslint": "^8.57.0",
    "@eslint/js": "^9.0.0"
  }
}
